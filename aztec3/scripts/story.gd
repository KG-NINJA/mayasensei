extends RefCounted

# Original story beats. No save fields: progress remains compatible with v1.
const CHAPTERS = [
	{"title": "第一章　消えた一枚", "question": "手帳の空白は、何を意味する？", "lines": [
		["ハル", "明日の展示に使う翡翠の手帳。その最後の一枚だけが見当たらないんだ。持出数の欄も、ほとんど読めない。"],
		["イネス", "消えた、という言葉には気をつけて。紙を守るために移すこともあるわ。まずは、残った記録を確かめましょう。"],
		["ハル", "『影ではなく、影が隠したものを読め』……不思議な書き込みだね。君も僕たちの調査に付き合ってくれる？"]]},
	{"title": "第二章　逆さの影", "question": "影が隠しているのは、どの記録？", "lines": [
		["ハル", "持ち出した遺物はゼロ。なら、宝探しの地図という僕の読み方は間違っていたのかな。"],
		["イネス", "数字は読めた。でも、写真にも読めない場所がある。基準図と見比べて、形が合う向きを探して。"],
		["ハル", "丸、三角、四角……向きを決める手掛かりはちゃんと写っている。影の下には何があったんだろう。"]]},
	{"title": "第三章　名前の行き先", "question": "三つの証拠から、何を伝えるべき？", "lines": [
		["ハル", "写真は逆さだった。影に隠れていたのは、地域協力者の名前欄。展示から、名前が抜けてしまっていたんだ。"],
		["イネス", "最後の一枚はこのテントにあるわ。修復票と現物を、あなた自身の目で照合してほしいの。"],
		["ハル", "数字、写真、修復票。思いつきではなく、全部の証拠で説明できる結論を見つけよう。"]]}
]

static func objective(chapter: int, observed: int, complete: bool) -> String:
	if complete:
		return "この場所の謎は解決。記録を再読するか、先へ進もう。"
	if observed < 3:
		return "手掛かりを調べよう　%d / 3\n%s" % [observed, CHAPTERS[chapter].question]
	return "手掛かりがそろった。\n「資料を読み解く」で謎に挑もう。"
